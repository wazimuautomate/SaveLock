<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for the SaveLock app-blocker. We need fast window/system-surface events so the overlay can
  reassert immediately if the notification shade, recents, or another app appears. We still do not
  read screen content (canRetrieveWindowContent="false").
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/accessibility_description" />
