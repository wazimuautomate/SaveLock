<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal device-admin policy. We deliberately request only "force-lock" (the least intrusive
  policy) — enough to register as an admin so uninstall requires disabling admin first. We do NOT
  request wipe, password, or camera-disable policies. This is uninstall friction, not control.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No policies requested. Being an active admin is enough for uninstall friction; we don't
         want any control powers (wipe/password/lock). Empty is valid and the least intrusive. -->
    <uses-policies />
</device-admin>
