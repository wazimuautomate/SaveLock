# ============================================================================
#  SaveLock BACKEND secrets (Supabase Edge Functions)
#  These live ONLY on the server. NEVER put them in the Android app or commit
#  the real filled-in file. Copy this file to `backend/.env`, paste real values,
#  then set them on Supabase with:  supabase secrets set --env-file backend/.env
# ============================================================================

# ---- Safaricom Daraja (M-Pesa) ----
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_PASSKEY=your-lipa-na-mpesa-online-passkey
# Head-office / store short code used ONLY to build the Lipa na M-Pesa password:
DARAJA_SHORTCODE=123456
# The TILL (Buy Goods) number the money actually lands in:
TILL_NUMBER=3156744
# Payment type: CustomerBuyGoodsOnline (till, default) or CustomerPayBillOnline (paybill):
DARAJA_TX_TYPE=CustomerBuyGoodsOnline
# "sandbox" while testing, "production" when live:
DARAJA_ENV=sandbox
# Where Daraja sends the payment result. Set this to your deployed stk-callback URL:
DARAJA_CALLBACK_URL=https://YOUR-PROJECT-REF.functions.supabase.co/stk-callback

# ---- Shared password between the app and this backend ----
# Invent any long random string. Put the SAME value in app/savelock.properties (APP_BACKEND_KEY).
# It stops strangers from triggering M-Pesa prompts through your backend.
APP_BACKEND_KEY=paste-a-long-random-string-here

# ---- Supabase (usually auto-provided to Edge Functions, listed here for local dev) ----
# In production, Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically,
# so you normally do NOT need to set these two by hand.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
